<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <!-- ============ 顶部栏（补状态栏内边距，避免被遮挡）============ -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/remote_title" />

    <!-- ============ 取景区 ============ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_weight="37">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardBackgroundColor="#000000"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <com.nxwa.nxconnect.ui.LiveViewView
                    android:id="@+id/liveView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- 状态卡片：分辨率/画质/帧率 + OSD 耗时 + 两路帧率（最多三行） -->
                <TextView
                    android:id="@+id/liveStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="10dp"
                    android:background="@drawable/bg_pill"
                    android:maxWidth="300dp"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp"
                    android:text="@string/liveview_stopped_hint"
                    android:textColor="#DCE6F5"
                    android:textSize="12sp" />


                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="10dp"
                    android:orientation="vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLive"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:minWidth="0dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="@string/liveview_start"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnQuality"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginTop="6dp"
                        android:minWidth="0dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="@string/quality_hq"
                        android:textSize="12sp" />
                </LinearLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <!-- ============ 控制区 ============
         ★ 必须放在滚动容器里，否则按键面板展开后总高度超过屏幕，
           超出部分会被直接裁掉且无法滚动（v0.10.0 就是这么"新功能全看不见"的）。
         权重 63 与取景区的 37 配对：不滚动时控制区也能占到屏幕内。 -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/controlScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="63"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/controlPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

        <!-- 主快门 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShutter"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:text="@string/shutter"
            android:textSize="18sp"
            app:icon="@drawable/ic_camera"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconSize="24dp" />

        <!-- B 门：开始后 S2 保持按下，快门持续开启，再点一次结束 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBulb"
            style="@style/NxButton.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/bulb_start"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/bulbInfo"
            style="@style/NxNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/bulb_prerequisite"
            android:visibility="gone" />

        <!-- B 门期间是否关掉相机屏幕（省电 + 避免屏幕漏光）。
             注意与「手机屏幕常亮」不冲突：那是两个不同的设备，各管各的。 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBulbLcd"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:minWidth="0dp"
            android:text="@string/bulb_lcd_off_on"
            android:textSize="12sp" />

        <!-- 次要按键：静音 / 播放切换 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSilentToggle"
                style="@style/NxButton.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/silent_off"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPlayback"
                style="@style/NxButton.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/playback"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKeysToggle"
                style="@style/NxButton.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/keys_expand"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- A/B/C 组按键面板（三组分区，运行时动态生成按钮） -->
        <include layout="@layout/view_remote_keys" />

        <TextView
            android:id="@+id/remoteHint"
            style="@style/NxNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/remote_hint" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
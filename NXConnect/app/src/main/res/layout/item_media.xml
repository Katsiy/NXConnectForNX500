<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="3dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="126dp"
        android:background="@drawable/bg_thumb">

        <ImageView
            android:id="@+id/thumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <!-- RAW / 视频等取不到缩略图时的占位 -->
        <LinearLayout
            android:id="@+id/placeholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/kindLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/nx_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/sizeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/nx_text_note"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 文件名条：贴在底部，带半透明底 -->
        <TextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_thumb_caption"
            android:ellipsize="middle"
            android:paddingStart="7dp"
            android:paddingTop="3dp"
            android:paddingEnd="7dp"
            android:paddingBottom="3dp"
            android:singleLine="true"
            android:textColor="#F0F5FF"
            android:textSize="10sp" />

        <!-- 视频标记 -->
        <TextView
            android:id="@+id/videoBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="5dp"
            android:background="@drawable/bg_pill"
            android:paddingStart="7dp"
            android:paddingTop="2dp"
            android:paddingEnd="7dp"
            android:paddingBottom="2dp"
            android:text="▶"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:visibility="gone" />

        <!-- 选中勾 -->
        <ImageView
            android:id="@+id/check"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="top|start"
            android:layout_margin="5dp"
            android:background="@drawable/bg_check"
            android:contentDescription="@null"
            android:padding="4dp"
            android:src="@drawable/ic_check"
            android:visibility="gone" />
    </FrameLayout>
</FrameLayout>
